// dashboard/measures.dax
// DAX measures for the Amazon PPC dashboard.
// Create a blank table named _Measures and paste each measure into it.
// Tables come from PostgreSQL: fact_search_terms, dim_campaign, vw_negative_candidates,
// vw_harvest_candidates, vw_search_term_kpis, vw_daily_kpis

// ---------- Parameters ----------
Target ACoS Value = 0.30
Break-even ACoS Value = 0.40

// ---------- Base ----------
Spend       = SUM ( fact_search_terms[spend] )
Sales       = SUM ( fact_search_terms[sales_7d] )
Orders      = SUM ( fact_search_terms[orders_7d] )
Clicks      = SUM ( fact_search_terms[clicks] )
Impressions = SUM ( fact_search_terms[impressions] )

// ---------- Core KPIs ----------
ACoS = DIVIDE ( [Spend], [Sales] )
ROAS = DIVIDE ( [Sales], [Spend] )
CTR  = DIVIDE ( [Clicks], [Impressions] )
CPC  = DIVIDE ( [Spend], [Clicks] )
CVR  = DIVIDE ( [Orders], [Clicks] )
RPC  = DIVIDE ( [Sales], [Clicks] )
AOV  = DIVIDE ( [Sales], [Orders] )

Optimal Bid = [RPC] * [Target ACoS Value]

ACoS vs Target (pts) = [ACoS] - [Target ACoS Value]

ACoS Status =
SWITCH (
    TRUE (),
    ISBLANK ( [ACoS] ),                     "No sales",
    [ACoS] <= [Target ACoS Value],          "✔ On target",
    [ACoS] <= [Break-even ACoS Value],      "▲ Above target",
                                            "✖ Losing money"
)

// ---------- Week over week ----------
Spend WoW % =
VAR _cur  = [Spend]
VAR _prev = CALCULATE ( [Spend], DATEADD ( fact_search_terms[report_date], -7, DAY ) )
RETURN DIVIDE ( _cur - _prev, _prev )

// ---------- Wasted spend (Page 2) ----------
Wasted Spend      = SUM ( vw_negative_candidates[spend] )
Wasted Spend %    = DIVIDE ( [Wasted Spend], CALCULATE ( [Spend], REMOVEFILTERS () ) )
Zero-Order Spend  = CALCULATE ( [Wasted Spend], vw_negative_candidates[orders] = 0 )
Rows To Act On    = COUNTROWS ( vw_negative_candidates )
Monthly Savings   = [Wasted Spend] / 3          // 90-day window

// ---------- Harvest (Page 3) ----------
Harvest Keywords  = COUNTROWS ( vw_harvest_candidates )
Harvest Sales     = SUM ( vw_harvest_candidates[sales] )
Harvest ROAS      = DIVIDE ( [Harvest Sales], SUM ( vw_harvest_candidates[spend] ) )
